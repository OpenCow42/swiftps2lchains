{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OpenCow42/swiftps2lchains/main/schemas/release-manifest-v2.schema.json",
  "title": "SwiftPS2 complete suite release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "suiteVersion",
    "swiftSDKVersion",
    "rustSDKVersion",
    "buildID",
    "channel",
    "qualification",
    "releaseNotes",
    "compatibilityID",
    "hostTriples",
    "minimumAppVersion",
    "archive",
    "sourceArchive",
    "packageManifestSha256",
    "ps2devContractSha256",
    "components",
    "compilerMirror",
    "evidence",
    "signingKeyID",
    "target",
    "package"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseVersion": { "$ref": "#/$defs/semver" },
    "suiteVersion": { "$ref": "#/$defs/semver" },
    "swiftSDKVersion": { "$ref": "#/$defs/semver" },
    "rustSDKVersion": { "$ref": "#/$defs/semver" },
    "buildID": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["stable", "preview", "testing"] },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hardwareQualified", "requiredGate", "caveat"],
      "properties": {
        "status": {
          "enum": [
            "production-qualified",
            "emulator-qualified, hardware-unqualified",
            "candidate-unqualified"
          ]
        },
        "hardwareQualified": { "type": "boolean" },
        "requiredGate": { "type": "string", "minLength": 1 },
        "caveat": { "type": ["string", "null"] }
      }
    },
    "releaseNotes": { "type": "string", "minLength": 1 },
    "compatibilityID": { "type": "string", "minLength": 1 },
    "hostTriples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "minimumAppVersion": { "$ref": "#/$defs/semver" },
    "archive": { "$ref": "#/$defs/archive" },
    "sourceArchive": { "$ref": "#/$defs/archive" },
    "packageManifestSha256": { "$ref": "#/$defs/sha256" },
    "ps2devContractSha256": { "$ref": "#/$defs/sha256" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ps2swift", "llvm", "swift", "cmark", "rust", "ps2dev", "ps2sdk", "python"],
      "properties": {
        "ps2swift": { "$ref": "#/$defs/component" },
        "llvm": { "$ref": "#/$defs/component" },
        "swift": { "$ref": "#/$defs/component" },
        "cmark": { "$ref": "#/$defs/component" },
        "rust": { "$ref": "#/$defs/component" },
        "ps2dev": { "$ref": "#/$defs/component" },
        "ps2sdk": { "$ref": "#/$defs/component" },
        "python": { "$ref": "#/$defs/component" }
      }
    },
    "compilerMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "tag", "tagObject", "tree"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitObject" },
        "tag": { "type": "string", "minLength": 1 },
        "tagObject": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "summary"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsURL" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "signingKeyID": { "type": "string", "minLength": 1 },
    "target": { "$ref": "#/$defs/target" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactID", "version"],
      "properties": {
        "artifactID": { "const": "swiftps2-suite" },
        "version": { "$ref": "#/$defs/semver" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "stable" } } },
      "then": {
        "properties": {
          "qualification": {
            "properties": {
              "status": { "const": "production-qualified" },
              "hardwareQualified": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "channel": { "const": "preview" } } },
      "then": {
        "properties": {
          "qualification": {
            "properties": {
              "status": { "const": "emulator-qualified, hardware-unqualified" },
              "hardwareQualified": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "channel": { "const": "testing" } } },
      "then": {
        "properties": {
          "qualification": {
            "properties": {
              "status": { "const": "candidate-unqualified" },
              "hardwareQualified": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "httpsURL": { "type": "string", "format": "uri", "pattern": "^https://" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256", "format"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsURL" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "format": { "const": "tar.gz" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "tree": { "$ref": "#/$defs/gitObject" },
        "releaseTag": { "type": "string", "minLength": 1 },
        "archiveSha256": { "$ref": "#/$defs/sha256" }
      },
      "anyOf": [
        { "required": ["revision"] },
        { "required": ["releaseTag", "archiveSha256"] }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triple",
        "cpu",
        "abi",
        "elfClass",
        "endianness",
        "pointerWidth",
        "integerWidth",
        "gprWidth",
        "floatingPointABI",
        "smallDataThreshold",
        "linkage"
      ],
      "properties": {
        "triple": { "const": "mips64el-scei-ps2" },
        "cpu": { "const": "r5900" },
        "abi": { "const": "n32" },
        "elfClass": { "const": "ELF32" },
        "endianness": { "const": "little" },
        "pointerWidth": { "const": 32 },
        "integerWidth": { "const": 32 },
        "gprWidth": { "const": 64 },
        "floatingPointABI": { "const": "hard-single" },
        "smallDataThreshold": { "const": 0 },
        "linkage": { "const": "static" }
      }
    }
  }
}

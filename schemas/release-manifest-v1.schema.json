{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OpenCow42/swiftps2lchains/main/schemas/release-manifest-v1.schema.json",
  "title": "SwiftPS2 SDK release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "sdkVersion",
    "buildID",
    "channel",
    "qualification",
    "releaseNotes",
    "compatibilityID",
    "hostTriples",
    "minimumAppVersion",
    "archive",
    "packageManifestSha256",
    "ps2devContractSha256",
    "components",
    "compilerMirror",
    "evidence",
    "signingKeyID",
    "target",
    "package"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseVersion": { "type": "string", "minLength": 5 },
    "sdkVersion": { "type": "string", "minLength": 5 },
    "buildID": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["stable", "preview"] },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hardwareQualified", "requiredGate", "caveat"],
      "properties": {
        "status": {
          "enum": ["production-qualified", "emulator-qualified, hardware-unqualified"]
        },
        "hardwareQualified": { "type": "boolean" },
        "requiredGate": { "type": "string", "minLength": 1 },
        "caveat": { "type": ["string", "null"] }
      }
    },
    "releaseNotes": { "type": "string", "minLength": 1 },
    "compatibilityID": { "type": "string", "minLength": 1 },
    "hostTriples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "minimumAppVersion": { "type": "string", "minLength": 5 },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256", "format"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "const": "tar.gz" }
      }
    },
    "packageManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ps2devContractSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ps2swift", "llvm", "swift", "cmark"],
      "properties": {
        "ps2swift": { "$ref": "#/$defs/component" },
        "llvm": { "$ref": "#/$defs/component" },
        "swift": { "$ref": "#/$defs/component" },
        "cmark": { "$ref": "#/$defs/component" }
      }
    },
    "compilerMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "tag", "tree"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "summary"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "signingKeyID": { "type": "string", "minLength": 1 },
    "target": { "type": "object" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactID", "version"],
      "properties": {
        "artifactID": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 5 }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}

#!/usr/bin/env swift

import CryptoKit
import Darwin
import Foundation

private enum DemoError: Error, CustomStringConvertible {
    case message(String)

    var description: String {
        switch self {
        case let .message(text): text
        }
    }
}

private struct Options {
    var channel = "testing"
    var channelURL: URL?
    var trustRoot: URL?
    var output: URL?
    var profile = "debug-emulator"
    var pcsx2: URL?
    var launch = false
    var fullscreen = false
    var resolveOnly = false
    var showHelp = false
}

private struct ChannelDocument: Decodable {
    struct Release: Decodable {
        let version: String
        let manifestURL: String
        let manifestSignatureURL: String
        let manifestSHA256: String
    }

    let schemaVersion: Int
    let channel: String
    let signingKeyID: String
    let release: Release?
}

private struct ReleaseManifest: Decodable {
    struct Archive: Decodable {
        let url: String
        let bytes: Int64
        let sha256: String
        let format: String
    }

    struct Qualification: Decodable {
        let status: String
        let hardwareQualified: Bool
        let caveat: String?
    }

    struct Target: Decodable {
        let triple: String
        let cpu: String
        let abi: String
        let elfClass: String
    }

    let schemaVersion: Int
    let releaseVersion: String
    let channel: String
    let signingKeyID: String
    let archive: Archive
    let packageManifestSha256: String
    let qualification: Qualification
    let hostTriples: [String]
    let target: Target
}

private struct BuildManifest: Decodable {
    struct Artifact: Decodable {
        let path: String
        let bytes: Int64
        let sha256: String
    }

    let buildID: String
    let artifacts: [Artifact]
}

private struct ResolvedRelease {
    let manifest: ReleaseManifest
    let workRoot: URL
}

private let usage = """
Usage: ./scripts/swiftps2-demo [options]

Download and verify a published SwiftPS2 compiler suite, compile the public
Moving Colors Swift demo, and emit artifacts/moving-colors.elf.

Options:
  --channel stable|preview|testing  Signed SDK channel (default: testing).
  --output PATH                    Destination ELF (default: artifacts/moving-colors.elf).
  --profile NAME                   Compiler profile (default: debug-emulator).
  --run                            Launch the built ELF in PCSX2.
  --pcsx2 PATH                     PCSX2 .app or executable; otherwise auto-detect it.
  --fullscreen                     Ask PCSX2 to start fullscreen; implies --run.
  --resolve-only                   Verify metadata and print the selected release only.
  --channel-url URL                Alternate channel document for mirrors or testing.
  --trust-root PATH                Alternate raw Ed25519 public key; requires --channel-url.
  -h, --help                       Show this help.

The current Testing channel is candidate-unqualified and makes no emulator or
hardware qualification claim. PCSX2 and a legally obtained BIOS are separate.
"""

private func repositoryRoot() -> URL {
    URL(fileURLWithPath: #filePath)
        .standardizedFileURL
        .deletingLastPathComponent()
        .deletingLastPathComponent()
}

private func fileURL(_ value: String) -> URL {
    if value.hasPrefix("/") {
        return URL(fileURLWithPath: value).standardizedFileURL
    }
    return URL(fileURLWithPath: FileManager.default.currentDirectoryPath)
        .appendingPathComponent(value)
        .standardizedFileURL
}

private func requiredValue(_ arguments: [String], _ index: inout Int, option: String) throws -> String {
    index += 1
    guard index < arguments.count else {
        throw DemoError.message("\(option) requires a value")
    }
    return arguments[index]
}

private func parseOptions(_ arguments: [String]) throws -> Options {
    var result = Options()
    var index = 1
    while index < arguments.count {
        switch arguments[index] {
        case "--channel":
            result.channel = try requiredValue(arguments, &index, option: "--channel")
        case "--channel-url":
            let value = try requiredValue(arguments, &index, option: "--channel-url")
            guard let url = URL(string: value), url.scheme != nil else {
                throw DemoError.message("--channel-url must be an absolute URL")
            }
            result.channelURL = url
        case "--trust-root":
            result.trustRoot = fileURL(try requiredValue(arguments, &index, option: "--trust-root"))
        case "--output":
            result.output = fileURL(try requiredValue(arguments, &index, option: "--output"))
        case "--profile":
            result.profile = try requiredValue(arguments, &index, option: "--profile")
        case "--pcsx2":
            result.pcsx2 = fileURL(try requiredValue(arguments, &index, option: "--pcsx2"))
        case "--run":
            result.launch = true
        case "--fullscreen":
            result.fullscreen = true
            result.launch = true
        case "--resolve-only":
            result.resolveOnly = true
        case "-h", "--help":
            result.showHelp = true
        default:
            throw DemoError.message("unknown option: \(arguments[index])")
        }
        index += 1
    }

    guard ["stable", "preview", "testing"].contains(result.channel) else {
        throw DemoError.message("--channel must be stable, preview, or testing")
    }
    if result.trustRoot != nil, result.channelURL == nil {
        throw DemoError.message("--trust-root is allowed only with an explicit --channel-url")
    }
    guard !result.profile.isEmpty else {
        throw DemoError.message("--profile cannot be empty")
    }
    return result
}

private func hexadecimal<D: Sequence>(_ digest: D) -> String where D.Element == UInt8 {
    digest.map { String(format: "%02x", $0) }.joined()
}

private func sha256(_ data: Data) -> String {
    hexadecimal(SHA256.hash(data: data))
}

private func sha256(_ url: URL) throws -> String {
    let handle = try FileHandle(forReadingFrom: url)
    defer { try? handle.close() }
    var hasher = SHA256()
    while let chunk = try handle.read(upToCount: 1024 * 1024), !chunk.isEmpty {
        hasher.update(data: chunk)
    }
    return hexadecimal(hasher.finalize())
}

private func signatureData(_ encoded: Data, label: String) throws -> Data {
    guard let text = String(data: encoded, encoding: .utf8),
          let value = Data(base64Encoded: text.trimmingCharacters(in: .whitespacesAndNewlines)) else {
        throw DemoError.message("\(label) is not a base64 Ed25519 signature")
    }
    return value
}

private func verify(document: Data, signature: Data, publicKeyURL: URL, label: String) throws {
    let encodedKey = try Data(contentsOf: publicKeyURL)
    guard let keyText = String(data: encodedKey, encoding: .utf8),
          let keyData = Data(base64Encoded: keyText.trimmingCharacters(in: .whitespacesAndNewlines)) else {
        throw DemoError.message("invalid raw Ed25519 trust root: \(publicKeyURL.path)")
    }
    let publicKey = try Curve25519.Signing.PublicKey(rawRepresentation: keyData)
    guard publicKey.isValidSignature(signature, for: document) else {
        throw DemoError.message("\(label) Ed25519 signature is invalid")
    }
}

private func load(_ url: URL, allowLocal: Bool, label: String) throws -> Data {
    let scheme = url.scheme?.lowercased()
    guard scheme == "https" || (allowLocal && scheme == "file") else {
        throw DemoError.message("\(label) must use HTTPS")
    }
    do {
        return try Data(contentsOf: url)
    } catch {
        throw DemoError.message("could not load \(label) from \(url.absoluteString): \(error.localizedDescription)")
    }
}

private func expectedKeyID(channel: String) -> String {
    channel == "testing" ? "swiftps2-testing-1" : "swiftps2-release-1"
}

private func expectedQualification(channel: String) -> (status: String, hardware: Bool) {
    switch channel {
    case "stable": ("production-qualified", true)
    case "preview": ("emulator-qualified, hardware-unqualified", false)
    default: ("candidate-unqualified", false)
    }
}

private func signatureURL(adjacentTo document: URL) throws -> URL {
    guard let result = URL(string: document.absoluteString + ".sig") else {
        throw DemoError.message("cannot form the channel signature URL")
    }
    return result
}

private func resolveRelease(options: Options, root: URL) throws -> ResolvedRelease {
    let allowLocal = options.channelURL?.scheme?.lowercased() == "file"
    if allowLocal && options.trustRoot == nil {
        throw DemoError.message("file channel URLs require an explicit --trust-root")
    }
    let channelURL = options.channelURL ?? URL(
        string: "https://raw.githubusercontent.com/OpenCow42/swiftps2lchains/main/channels/\(options.channel).json"
    )!
    let channelData = try load(channelURL, allowLocal: allowLocal, label: "channel document")
    let channelSignature = try signatureData(
        load(try signatureURL(adjacentTo: channelURL), allowLocal: allowLocal, label: "channel signature"),
        label: "channel signature"
    )
    let channel = try JSONDecoder().decode(ChannelDocument.self, from: channelData)
    let keyID = expectedKeyID(channel: options.channel)
    guard channel.schemaVersion == 1,
          channel.channel == options.channel,
          channel.signingKeyID == keyID else {
        throw DemoError.message("channel identity does not match the selected channel and pinned key")
    }
    let trustRoot = options.trustRoot ?? root.appendingPathComponent("keys/\(keyID).pub")
    try verify(document: channelData, signature: channelSignature, publicKeyURL: trustRoot, label: "channel")

    guard let pointer = channel.release else {
        throw DemoError.message("the signed \(options.channel) channel has no published SDK")
    }
    guard let manifestURL = URL(string: pointer.manifestURL),
          let manifestSignatureURL = URL(string: pointer.manifestSignatureURL) else {
        throw DemoError.message("the signed channel contains invalid release URLs")
    }
    let manifestData = try load(manifestURL, allowLocal: allowLocal, label: "release manifest")
    guard sha256(manifestData) == pointer.manifestSHA256 else {
        throw DemoError.message("release manifest SHA-256 does not match the signed channel")
    }
    let manifestSignature = try signatureData(
        load(manifestSignatureURL, allowLocal: allowLocal, label: "release manifest signature"),
        label: "release manifest signature"
    )
    try verify(document: manifestData, signature: manifestSignature, publicKeyURL: trustRoot, label: "release manifest")

    let manifest = try JSONDecoder().decode(ReleaseManifest.self, from: manifestData)
    let qualification = expectedQualification(channel: options.channel)
    guard manifest.schemaVersion == 2,
          manifest.releaseVersion == pointer.version,
          manifest.channel == options.channel,
          manifest.signingKeyID == keyID,
          manifest.qualification.status == qualification.status,
          manifest.qualification.hardwareQualified == qualification.hardware,
          manifest.archive.format == "tar.gz",
          manifest.archive.bytes > 0,
          manifest.archive.sha256.range(of: "^[0-9a-f]{64}$", options: .regularExpression) != nil,
          manifest.packageManifestSha256.range(of: "^[0-9a-f]{64}$", options: .regularExpression) != nil,
          manifest.target.triple == "mips64el-scei-ps2",
          manifest.target.cpu == "r5900",
          manifest.target.abi == "n32",
          manifest.target.elfClass == "ELF32" else {
        throw DemoError.message("release manifest violates the SwiftPS2 channel or target contract")
    }
    guard let archiveURL = URL(string: manifest.archive.url),
          archiveURL.scheme?.lowercased() == "https" || allowLocal else {
        throw DemoError.message("release archive must use HTTPS")
    }
    return ResolvedRelease(manifest: manifest, workRoot: root.appendingPathComponent(".swiftps2"))
}

@discardableResult
private func run(
    _ executable: URL,
    _ arguments: [String],
    capture: Bool = false,
    wait: Bool = true
) throws -> Data {
    let process = Process()
    process.executableURL = executable
    process.arguments = arguments
    let pipe = capture ? Pipe() : nil
    if let pipe {
        process.standardOutput = pipe
        process.standardError = pipe
    } else {
        process.standardOutput = FileHandle.standardOutput
        process.standardError = FileHandle.standardError
    }
    try process.run()
    guard wait else { return Data() }
    process.waitUntilExit()
    let output = pipe?.fileHandleForReading.readDataToEndOfFile() ?? Data()
    guard process.terminationReason == .exit, process.terminationStatus == 0 else {
        let detail = String(data: output, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines)
        let suffix = detail.flatMap { $0.isEmpty ? nil : "\n\($0)" } ?? ""
        throw DemoError.message(
            "command failed (\(process.terminationStatus)): \(executable.path)\(suffix)"
        )
    }
    return output
}

private func ensureSupportedHost(manifest: ReleaseManifest) throws {
    let architectureData = try run(URL(fileURLWithPath: "/usr/bin/uname"), ["-m"], capture: true)
    let architecture = String(data: architectureData, encoding: .utf8)?
        .trimmingCharacters(in: .whitespacesAndNewlines)
    guard architecture == "arm64",
          manifest.hostTriples.contains("arm64-apple-macosx13.0"),
          ProcessInfo.processInfo.operatingSystemVersion.majorVersion >= 13 else {
        throw DemoError.message("this published SDK requires Apple Silicon and macOS 13 or newer")
    }
}

private func validArchive(_ archive: URL, manifest: ReleaseManifest) throws -> Bool {
    guard FileManager.default.fileExists(atPath: archive.path) else { return false }
    let values = try archive.resourceValues(forKeys: [.fileSizeKey, .isRegularFileKey])
    guard values.isRegularFile == true, Int64(values.fileSize ?? -1) == manifest.archive.bytes else { return false }
    return try sha256(archive) == manifest.archive.sha256
}

private func downloadArchive(release: ResolvedRelease) throws -> URL {
    let manager = FileManager.default
    let manifest = release.manifest
    let cache = release.workRoot.appendingPathComponent("cache", isDirectory: true)
    try manager.createDirectory(at: cache, withIntermediateDirectories: true)
    guard let remote = URL(string: manifest.archive.url), !remote.lastPathComponent.isEmpty else {
        throw DemoError.message("release archive URL has no filename")
    }
    let archive = cache.appendingPathComponent(remote.lastPathComponent)
    if try validArchive(archive, manifest: manifest) {
        print("Using verified cached SDK archive: \(archive.path)")
        return archive
    }
    if manager.fileExists(atPath: archive.path) {
        try manager.removeItem(at: archive)
    }
    let partial = archive.appendingPathExtension("part")
    print("Downloading \(manifest.releaseVersion) SDK (\(manifest.archive.bytes) bytes)…")
    fflush(stdout)
    try run(
        URL(fileURLWithPath: "/usr/bin/curl"),
        [
            "--fail", "--location", "--show-error", "--continue-at", "-",
            "--proto", "=https", "--tlsv1.2", "--output", partial.path,
            remote.absoluteString,
        ]
    )
    guard try validArchive(partial, manifest: manifest) else {
        try? manager.removeItem(at: partial)
        throw DemoError.message("downloaded SDK archive size or SHA-256 is invalid")
    }
    try manager.moveItem(at: partial, to: archive)
    return archive
}

private func contained(_ candidate: URL, by root: URL) -> Bool {
    let rootComponents = root.standardizedFileURL.pathComponents
    let candidateComponents = candidate.standardizedFileURL.pathComponents
    return candidateComponents.count >= rootComponents.count &&
        Array(candidateComponents.prefix(rootComponents.count)) == rootComponents
}

private func validateSuite(_ suite: URL, manifest: ReleaseManifest) throws {
    let manager = FileManager.default
    let packageManifest = suite.appendingPathComponent("share/swiftps2-suite/package-manifest.json")
    guard manager.fileExists(atPath: packageManifest.path),
          try sha256(packageManifest) == manifest.packageManifestSha256 else {
        throw DemoError.message("installed suite package manifest does not match the signed release")
    }
    let swiftps2 = suite.appendingPathComponent("bin/swiftps2")
    guard manager.isExecutableFile(atPath: swiftps2.path) else {
        throw DemoError.message("installed suite is missing its validated entry points")
    }
    try run(swiftps2, ["doctor"])
}

private func installedSuite(in releaseRoot: URL) throws -> URL? {
    let manager = FileManager.default
    guard manager.fileExists(atPath: releaseRoot.path) else { return nil }
    let entries = try manager.contentsOfDirectory(
        at: releaseRoot,
        includingPropertiesForKeys: [.isDirectoryKey, .isSymbolicLinkKey],
        options: [.skipsHiddenFiles]
    )
    let suites = try entries.filter { entry in
        let values = try entry.resourceValues(forKeys: [.isDirectoryKey, .isSymbolicLinkKey])
        return values.isDirectory == true && values.isSymbolicLink != true &&
            manager.isExecutableFile(atPath: entry.appendingPathComponent("bin/swiftps2").path)
    }
    guard suites.count <= 1 else {
        throw DemoError.message("installed release contains multiple suite roots: \(releaseRoot.path)")
    }
    return suites.first
}

private func installSuite(release: ResolvedRelease, archive: URL) throws -> URL {
    let manager = FileManager.default
    let releases = release.workRoot.appendingPathComponent("suites", isDirectory: true)
    let releaseRoot = releases.appendingPathComponent(release.manifest.releaseVersion, isDirectory: true)
    if let existing = try installedSuite(in: releaseRoot) {
        try validateSuite(existing, manifest: release.manifest)
        print("Using installed SDK: \(existing.path)")
        return existing
    }
    if manager.fileExists(atPath: releaseRoot.path) {
        throw DemoError.message("incomplete SDK install exists at \(releaseRoot.path); remove that generated directory and retry")
    }

    let staging = release.workRoot
        .appendingPathComponent("staging", isDirectory: true)
        .appendingPathComponent(UUID().uuidString, isDirectory: true)
    try manager.createDirectory(at: staging, withIntermediateDirectories: true)
    defer { try? manager.removeItem(at: staging) }
    print("Extracting and validating the signed SDK…")
    fflush(stdout)
    try run(URL(fileURLWithPath: "/usr/bin/tar"), ["-xpzf", archive.path, "-C", staging.path])
    let roots = try manager.contentsOfDirectory(
        at: staging,
        includingPropertiesForKeys: [.isDirectoryKey, .isSymbolicLinkKey],
        options: [.skipsHiddenFiles]
    )
    guard roots.count == 1 else {
        throw DemoError.message("SDK archive must contain exactly one top-level suite")
    }
    let suite = roots[0]
    let values = try suite.resourceValues(forKeys: [.isDirectoryKey, .isSymbolicLinkKey])
    guard values.isDirectory == true, values.isSymbolicLink != true, contained(suite, by: staging) else {
        throw DemoError.message("SDK archive has an unsafe top-level suite")
    }
    try validateSuite(suite, manifest: release.manifest)

    try manager.createDirectory(at: releaseRoot, withIntermediateDirectories: true)
    let destination = releaseRoot.appendingPathComponent(suite.lastPathComponent, isDirectory: true)
    try manager.moveItem(at: suite, to: destination)
    print("Installed SDK: \(destination.path)")
    return destination
}

private func buildDemo(options: Options, root: URL, release: ResolvedRelease, suite: URL) throws -> URL {
    let package = root.appendingPathComponent("examples/moving-colors", isDirectory: true)
    let buildRoot = release.workRoot
        .appendingPathComponent("build/moving-colors/\(options.profile)", isDirectory: true)
    let swiftps2 = suite.appendingPathComponent("bin/swiftps2")
    print("Building Moving Colors with the published Swift compiler…")
    fflush(stdout)
    try run(
        swiftps2,
        [
            "build", "--language", "swift", "--package", package.path,
            "--profile", options.profile, "--output", buildRoot.path,
        ]
    )

    let manifestURL = buildRoot.appendingPathComponent("manifest.json")
    let manifestData = try Data(contentsOf: manifestURL)
    let buildManifest = try JSONDecoder().decode(BuildManifest.self, from: manifestData)
    let records = buildManifest.artifacts.filter { $0.path.hasSuffix(".elf") }
    guard records.count == 1 else {
        throw DemoError.message("build manifest must contain exactly one ELF")
    }
    let record = records[0]
    let builtELF = buildRoot.appendingPathComponent(record.path).standardizedFileURL
    guard contained(builtELF, by: buildRoot),
          FileManager.default.fileExists(atPath: builtELF.path),
          Int64((try builtELF.resourceValues(forKeys: [.fileSizeKey])).fileSize ?? -1) == record.bytes,
          try sha256(builtELF) == record.sha256 else {
        throw DemoError.message("built ELF does not match its audited build manifest")
    }

    let output = options.output ?? root.appendingPathComponent("artifacts/moving-colors.elf")
    try FileManager.default.createDirectory(at: output.deletingLastPathComponent(), withIntermediateDirectories: true)
    try Data(contentsOf: builtELF).write(to: output, options: .atomic)
    let publishedManifest = output.appendingPathExtension("manifest.json")
    var publishedManifestData = try JSONSerialization.data(
        withJSONObject: [
            "schemaVersion": 1,
            "buildID": buildManifest.buildID,
            "sourcePackage": "examples/moving-colors",
            "profile": options.profile,
            "compilerSuite": [
                "releaseVersion": release.manifest.releaseVersion,
                "qualification": release.manifest.qualification.status,
                "archiveSHA256": release.manifest.archive.sha256,
            ],
            "target": [
                "triple": release.manifest.target.triple,
                "cpu": release.manifest.target.cpu,
                "abi": release.manifest.target.abi,
                "elfClass": release.manifest.target.elfClass,
            ],
            "elf": [
                "path": output.lastPathComponent,
                "bytes": record.bytes,
                "sha256": record.sha256,
            ],
            "sourceBuildManifestSHA256": sha256(manifestData),
        ],
        options: [.prettyPrinted, .sortedKeys]
    )
    publishedManifestData.append(0x0a)
    try publishedManifestData.write(to: publishedManifest, options: .atomic)
    print("Published ELF: \(output.path)")
    print("ELF SHA-256: \(record.sha256)")
    print("Build manifest: \(publishedManifest.path)")
    return output
}

private func pcsx2Application(containing url: URL) -> URL? {
    var candidate = url.standardizedFileURL
    while candidate.path != "/" {
        if candidate.pathExtension == "app" { return candidate }
        candidate.deleteLastPathComponent()
    }
    return nil
}

private func discoverPCSX2(options: Options) throws -> URL {
    if let explicit = options.pcsx2 { return explicit }
    for key in ["PCSX2_EXECUTABLE", "PCSX2"] {
        if let value = ProcessInfo.processInfo.environment[key], !value.isEmpty {
            return fileURL(value)
        }
    }
    let manager = FileManager.default
    let roots = [
        URL(fileURLWithPath: "/Applications", isDirectory: true),
        manager.homeDirectoryForCurrentUser.appendingPathComponent("Applications", isDirectory: true),
    ]
    for root in roots {
        guard let entries = try? manager.contentsOfDirectory(
            at: root,
            includingPropertiesForKeys: [.isDirectoryKey],
            options: [.skipsHiddenFiles]
        ) else { continue }
        if let application = entries.sorted(by: { $0.lastPathComponent < $1.lastPathComponent }).first(where: {
            $0.pathExtension == "app" &&
                (Bundle(url: $0)?.bundleIdentifier == "net.pcsx2.pcsx2" ||
                    $0.lastPathComponent.lowercased().contains("pcsx2"))
        }) {
            return application
        }
    }
    throw DemoError.message("PCSX2 was not found; install it or pass --pcsx2 PATH")
}

private func launchPCSX2(options: Options, elf: URL) throws {
    let selection = try discoverPCSX2(options: options)
    let application = selection.pathExtension == "app" ? selection : pcsx2Application(containing: selection)
    var arguments = ["-batch"]
    if options.fullscreen { arguments.append("-fullscreen") }
    arguments.append(contentsOf: ["-earlyconsolelog", "-elf", elf.path])
    if let application {
        try run(
            URL(fileURLWithPath: "/usr/bin/open"),
            ["-na", application.path, "--args"] + arguments
        )
        print("Launched PCSX2: \(application.path)")
    } else {
        guard FileManager.default.isExecutableFile(atPath: selection.path) else {
            throw DemoError.message("PCSX2 is not executable: \(selection.path)")
        }
        try run(selection, arguments, wait: false)
        print("Launched PCSX2: \(selection.path)")
    }
}

private func main() throws {
    let options = try parseOptions(CommandLine.arguments)
    if options.showHelp {
        print(usage)
        return
    }
    let root = repositoryRoot()
    let release = try resolveRelease(options: options, root: root)
    print("Resolved \(release.manifest.releaseVersion) from the signed \(options.channel) channel")
    print("Qualification: \(release.manifest.qualification.status)")
    if let caveat = release.manifest.qualification.caveat, !caveat.isEmpty {
        print("Caveat: \(caveat)")
    }
    fflush(stdout)
    if options.resolveOnly { return }

    try ensureSupportedHost(manifest: release.manifest)
    let archive = try downloadArchive(release: release)
    let suite = try installSuite(release: release, archive: archive)
    let elf = try buildDemo(options: options, root: root, release: release, suite: suite)
    if options.launch {
        try launchPCSX2(options: options, elf: elf)
    }
}

do {
    try main()
} catch {
    fputs("swiftps2-demo: \(error)\n", stderr)
    exit(2)
}
